{"subs": [[0.0, 2.52, "أهلًا بيكم يا كباتن! أنا أحمد،"], [2.52, 4.53, "من منصات كابتن تايكوندو."], [4.53, 7.72, "هكون معاكم النهارده عشان أشرح لكم إزاي"], [7.72, 10.82, "تحصلوا على بطاقتكم الذهبية بكل سهولة."], [10.82, 14.09, "أهم حاجة تتبعوا الخطوات معايا. يلا بينا"], [14.09, 14.51, "نبدأ!"], [15.06, 17.69, "افتحوا الموقع، وادوسوا على القائمة،"], [17.69, 20.78, "وبعدين على \"الشهادات\". هتلاقوا زرار دهبي،"], [20.78, 22.66, "ادوسوا عليه. ولو أول مرة،"], [22.66, 24.77, "اختاروا \"إصدار بطاقة جديدة\"."], [25.32, 28.03, "اكتبوا اسمكم بالعربي وبالإنجليزي،"], [28.03, 30.49, "وبعدين الدولة والنادي. وبصّوا،"], [30.49, 33.19, "البطاقة بتتكتب قدامكم لحظة بلحظة!"], [33.19, 36.31, "والموقع ده من تصميم المهندس حسني رشاد."], [36.86, 39.22, "اكتبوا إيميل بتفتحوه فعلًا،"], [39.22, 41.49, "ورقم تليفونكم بكود الدولة."], [41.49, 44.55, "وبعدين عدد الأبطال المشاركين معاكم."], [44.55, 46.65, "ده اختياري، وللإدارة بس،"], [46.65, 50.32, "ومش بيظهر على البطاقة. ولو معندكمش لاعبين،"], [50.32, 52.32, "مفيش مشكلة! اكتبوا صفر،"], [52.32, 54.95, "وبرضه هتاخدوا البطاقة الذهبية."], [54.95, 57.13, "اعتبروها تذكار مننا ليكم!"], [57.68, 59.25, "دوسوا \"أرسل الكود\"،"], [59.25, 62.22, "وهيوصلكم كود من 6 أرقام على إيميلكم."], [62.22, 64.54, "اكتبوه هنا. ولو ما لقيتوهوش،"], [64.54, 67.93, "دوّروا في الرسايل المزعجة. أهو الكود وصل؟"], [67.93, 68.67, "يلا نكمل."], [69.22, 71.56, "اختاروا صورة وشكم فيها واضح."], [71.56, 73.57, "بعد كده اسحبوها بإصبعكم،"], [73.57, 76.92, "وكبّروها وصغّروها لحد ما وشكم يبقى في نص"], [76.92, 77.5, "الإطار."], [77.5, 80.85, "وفي حاجة حلوة تحت... هقولكم عليها حالًا!"], [81.4, 84.7, "عايزين صورة احترافية؟ مفيش أسهل من كده!"], [84.7, 87.83, "تحت البطاقة دوسوا على زرار \"اصنع صورة"], [87.83, 89.1, "مدرب احترافية\"،"], [89.1, 90.54, "هيظهر الأمر جاهز."], [90.54, 92.91, "دوسوا \"نسخ الأمر الاحترافي\"،"], [92.91, 96.21, "وبعدين \"انسخ واذهب مباشرة إلى ChatGPT\"."], [96.21, 99.59, "الصقوا الأمر وابعتوا. هيطلب منكم صورتكم،"], [99.59, 102.38, "ابعتوهاله. وبعد ما تبعتوا الصورة،"], [102.38, 104.84, "متكتبوش حاجة، دوسوا إرسال بس."], [104.84, 108.47, "هيسألكم كام سؤال بسيط: ماركة البدلة، لونها،"], [108.47, 112.11, "وإيه يتكتب على الحزام. اختاروا اللي يعجبكم،"], [112.11, 115.75, "وأكدوا في الآخر، وهتطلعلكم صورتكم احترافية!"], [116.3, 119.32, "ومعانا فيديو ترويجي بسيط، واختياري!"], [119.32, 122.5, "ممكن لاعبكم يشارك في الفيديو الترويجي"], [122.5, 123.19, "للبطولة."], [123.19, 126.12, "اختاروا \"نعم\"، واكتبوا رقم واتساب."], [126.12, 128.88, "وصوّروا اللاعب ببدلة التايكوندو،"], [128.88, 132.58, "وهو بيقول شعار البطولة بصوت واضح: \"أنا بطل…"], [132.58, 134.91, "والأبطال لا يعرفون حدودًا\"."], [134.91, 136.98, "والمدرب كمان يقدر يشارك!"], [136.98, 140.25, "علّموا على \"أرغب أن أشارك أنا أيضًا في"], [140.25, 142.15, "الفيديو بصفتي المدرب\"،"], [142.15, 143.87, "وصوّروا نفسكم بوضوح،"], [143.87, 147.66, "ويُفضّل ببدلة التايكوندو، وقولوا: \"أنا فلان،"], [147.66, 151.28, "من بلد كذا، وأنا مشارك في بطولة الأساسيات،"], [151.28, 153.26, "وأنا عندي بطل أو بطلة\"."], [153.26, 155.59, "والتصوير بالطول على هاتفكم،"], [155.59, 159.29, "من غير كتابة أو نصوص أو ملصقات على الفيديو."], [159.84, 161.49, "دلوقتي وصلنا للإقرار."], [161.49, 164.17, "معناه إنكم بتأكدوا إن بياناتكم صح،"], [164.17, 167.09, "وإنكم موافقين نستخدم صورتكم وبياناتكم"], [167.09, 170.16, "عشان نطلّع بطاقة المدرب وننظّم البطولة."], [170.16, 171.58, "علّموا على المربع،"], [171.58, 175.05, "ودوسوا \"احفظ بياناتي وأصدر البطاقة\". ومبروك!"], [175.05, 177.65, "دلوقتي معاكم كودكم الخاص والفريد."], [177.65, 178.83, "شكرًا ليكم بجد!"], [179.38, 181.42, "حمّلوا بطاقتكم PNG أو JPG،"], [181.42, 184.39, "وافتكروا الكود عشان لو عايزين تعدّلوا."], [184.39, 186.97, "وطبعًا متنسوش تنزّلوا البطاقة على"], [186.97, 188.54, "الفيسبوك والتيك توك."], [188.54, 191.2, "عايزين الناس كلها تعرف إن في بطولة"], [191.2, 192.61, "اتعملت مخصوص لينا!"], [193.16, 194.95, "ولو عايزين تغيّروا حاجة،"], [194.95, 196.59, "ادوسوا \"تعديل بطاقتي\"،"], [196.59, 199.28, "واكتبوا رقم تليفونكم وإيميلكم وآخر 4"], [199.28, 200.4, "أرقام من الكود."], [200.4, 201.96, "وعدّلوا اللي عايزينه،"], [201.96, 203.83, "وهتطلعوا البطاقة من جديد."], [204.38, 205.22, "وفي الآخر،"], [205.22, 208.56, "لازم أشكر كابتن تايكوندو على وجودي معاكم"], [208.56, 209.14, "دلوقتي."], [209.14, 211.57, "وشكرًا للكابتن إبراهيم الحاج،"], [211.57, 214.91, "صاحب المبادرة ومؤسسها، والحكم الدولي علي"], [214.91, 215.25, "نور،"], [215.25, 218.84, "رئيس الحكام، وكل اللي ساهم في نجاح البطولة."], [218.84, 221.93, "وشكرًا للمهندس حسني رشاد على التصميم!"], [221.93, 223.27, "واحتفظوا بكودكم،"], [223.27, 226.36, "لأن بيه هتاخدوا هديتكم الخاصة من منصة"], [226.36, 227.62, "كابتن تايكوندو."], [227.62, 230.04, "يلا يا كباتن، إحنا محتاجينكم!"], [230.04, 232.88, "شاركونا وادعموا أبطالنا. أنا أحمد،"], [232.88, 234.55, "وبحلم أبقى بطل زيكم."], [234.55, 236.81, "نشوفكم على البطاقة الذهبية!"]], "start": {"01": 0.0, "02": 15.06, "03": 25.32, "04": 36.86, "05": 57.68, "06": 69.22, "07": 81.4, "08": 116.30000000000001, "09": 159.84, "10": 179.38, "11": 193.16, "12": 204.38}, "OUT0": 204.38, "BASE": 15.06, "SCREEN": 189.32}